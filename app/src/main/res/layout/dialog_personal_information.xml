<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header with Icon & Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:adjustViewBounds="true"
            android:background="@drawable/personal_information_container"
            android:contentDescription="@null"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/personal_information_symbol" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Personal Information"
                android:textColor="@color/primary_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Logged in account details"
                android:textColor="@color/secondary_text"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="14dp"
        android:background="@color/divider_color" />

    <!-- Info Field: Full Name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Full Name"
        android:textColor="@color/secondary_text"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvInfoFullName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_dialog_input"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:text="Full Name"
        android:textColor="@color/primary_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Info Field: Username -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Username"
        android:textColor="@color/secondary_text"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvInfoUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_dialog_input"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:text="Username"
        android:textColor="@color/primary_text"
        android:textSize="15sp" />

    <!-- Info Field: Email -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Email Address"
        android:textColor="@color/secondary_text"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvInfoEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_dialog_input"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:text="Email"
        android:textColor="@color/primary_text"
        android:textSize="15sp" />

    <!-- Info Field: Preset Code -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Preset Code"
        android:textColor="@color/secondary_text"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvInfoPresetCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_dialog_input"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:text="Preset Code"
        android:textColor="#D84315"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Action Button -->
    <android.widget.Button
        android:id="@+id/btnCloseInfo"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_dialog_button_primary"
        android:text="Close"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>