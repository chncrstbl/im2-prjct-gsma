<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header with Icon & Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:adjustViewBounds="true"
            android:background="@drawable/edit_profile_container"
            android:contentDescription="@null"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/edit_profile_symbol" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit Profile"
                android:textColor="@color/primary_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Update your teacher profile details"
                android:textColor="@color/secondary_text"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="14dp"
        android:background="@color/divider_color" />

    <!-- Profile Photo Selection -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivDialogProfileAvatar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:adjustViewBounds="true"
                android:contentDescription="Profile Photo"
                android:scaleType="centerCrop"
                android:src="@drawable/teacher_account_profile_placeholder"
                app:shapeAppearanceOverlay="@style/CircleImageViewStyle" />

            <ImageView
                android:id="@+id/btnSelectPhoto"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_alignEnd="@id/ivDialogProfileAvatar"
                android:layout_alignBottom="@id/ivDialogProfileAvatar"
                android:background="@drawable/edit_profile_container"
                android:contentDescription="Change Picture"
                android:padding="4dp"
                android:src="@drawable/edit_profile_symbol" />
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tap to change picture"
            android:textColor="@color/secondary_text"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Input 1: Full Name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Full Name"
        android:textColor="@color/secondary_text"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etDialogFullName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_dialog_input"
        android:hint="Enter full name"
        android:inputType="textPersonName"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textColor="@color/primary_text"
        android:textColorHint="#9E9E9E"
        android:textSize="14sp" />

    <!-- Input 2: Email Address -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Email Address"
        android:textColor="@color/secondary_text"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etDialogEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_dialog_input"
        android:hint="Enter email address"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textColor="@color/primary_text"
        android:textColorHint="#9E9E9E"
        android:textSize="14sp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <android.widget.Button
            android:id="@+id/btnCancelEditProfile"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_button_secondary"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#616161"
            android:textSize="14sp"
            android:textStyle="bold" />

        <android.widget.Button
            android:id="@+id/btnSaveEditProfile"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_button_primary"
            android:text="Save"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>