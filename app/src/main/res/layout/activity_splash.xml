<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFDF0"
    tools:context=".SplashActivity">

    <!-- Top-left cloud -->
    <ImageView
        android:id="@+id/cloudTopLeft"
        android:layout_width="75dp"
        android:layout_height="65dp"
        android:layout_marginStart="-20dp"
        android:layout_marginTop="35dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/cloud_1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top-right cloud -->
    <ImageView
        android:id="@+id/cloudTopRight"
        android:layout_width="90dp"
        android:layout_height="70dp"
        android:layout_marginEnd="-15dp"
        android:layout_marginTop="55dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/cloud_3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Small sun -->
    <ImageView
        android:id="@+id/sun"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:layout_marginTop="25dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/sun"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Left middle cloud -->
    <ImageView
        android:id="@+id/cloudMiddleLeft"
        android:layout_width="80dp"
        android:layout_height="55dp"
        android:layout_marginStart="-15dp"
        android:layout_marginTop="145dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/fullcloud_1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Right middle cloud -->
    <ImageView
        android:id="@+id/cloudMiddleRight"
        android:layout_width="80dp"
        android:layout_height="55dp"
        android:layout_marginEnd="-10dp"
        android:layout_marginTop="155dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/fullcloud_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Little Learners logo -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="195dp"
        android:layout_height="55dp"
        android:layout_marginTop="82dp"
        android:contentDescription="Little Learners"
        android:scaleType="fitCenter"
        android:src="@drawable/littlelearners"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Grading System -->
    <ImageView
        android:id="@+id/gradingSystem"
        android:layout_width="125dp"
        android:layout_height="28dp"
        android:layout_marginTop="2dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/grading_system"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logo" />

    <!-- Track . Grade . Grow -->
    <ImageView
        android:id="@+id/tagline"
        android:layout_width="125dp"
        android:layout_height="25dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/track_grade_grow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/gradingSystem" />

    <!-- Background field -->
    <ImageView
        android:id="@+id/fieldBackground"
        android:layout_width="0dp"
        android:layout_height="125dp"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/field_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Children -->
    <ImageView
        android:id="@+id/children"
        android:layout_width="225dp"
        android:layout_height="190dp"
        android:layout_marginBottom="3dp"
        android:contentDescription="Little Learners students"
        android:scaleType="fitCenter"
        android:src="@drawable/children"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>