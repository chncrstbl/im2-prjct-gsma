<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".home.MainActivity">

    <!-- Top Yellow Header Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFCC00"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/ivHeaderTitle"
            android:layout_width="130dp"
            android:layout_height="22dp"
            android:layout_centerInParent="true"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:src="@drawable/little_learners" />

        <ImageView
            android:id="@+id/ivProfile"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:adjustViewBounds="true"
            android:contentDescription="@string/student_avatar"
            android:src="@drawable/profile_teacher" />
    </RelativeLayout>

    <!-- Scrollable Main Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Greeting Header Section -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/ivDecorSun"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:src="@drawable/decor_sun" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/ivDecorSun"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="95dp"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/good_morning"
                        android:src="@drawable/good_morning" />

                    <ImageView
                        android:layout_width="88dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/teacher_exclamation"
                        android:src="@drawable/teacher" />
                </LinearLayout>
            </RelativeLayout>

            <!-- 2x2 Feature Cards Grid -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alignmentMode="alignBounds"
                android:columnCount="2"
                android:columnOrderPreserved="false"
                android:rowCount="2">

                <!-- Card 1: Students (Top-Left) -->
                <RelativeLayout
                    android:id="@+id/btnStudentsCard"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/students_background"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/ivStudentsSymbol"
                        android:layout_width="105dp"
                        android:layout_height="85dp"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="6dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/students_symbol" />

                    <ImageView
                        android:layout_width="68dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/ivStudentsSymbol"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="8dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/card_students_title"
                        android:src="@drawable/students" />
                </RelativeLayout>

                <!-- Card 2: Enter Grades (Top-Right) -->
                <RelativeLayout
                    android:id="@+id/btnGradesCard"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/enter_grades_background"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/ivGradesSymbol"
                        android:layout_width="105dp"
                        android:layout_height="85dp"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="6dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/enter_grades_symbol" />

                    <ImageView
                        android:layout_width="84dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/ivGradesSymbol"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="8dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/btn_grades"
                        android:src="@drawable/enter_grades" />
                </RelativeLayout>

                <!-- Card 3: Reports (Bottom-Left) -->
                <RelativeLayout
                    android:id="@+id/btnReportsCard"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/reports_background"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/ivReportsSymbol"
                        android:layout_width="105dp"
                        android:layout_height="85dp"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="6dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/reports_symbol" />

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/ivReportsSymbol"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="8dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/card_reports_title"
                        android:src="@drawable/reports" />
                </RelativeLayout>

                <!-- Card 4: Analytics (Bottom-Right) -->
                <RelativeLayout
                    android:id="@+id/btnAnalyticsCard"
                    android:layout_width="0dp"
                    android:layout_height="160dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:background="@drawable/analytics_background"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/ivAnalyticsSymbol"
                        android:layout_width="105dp"
                        android:layout_height="85dp"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="6dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/analytics_symbol" />

                    <ImageView
                        android:layout_width="68dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/ivAnalyticsSymbol"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="8dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/analytics"
                        android:src="@drawable/analytics" />
                </RelativeLayout>

            </GridLayout>

            <!-- Inspirational Banner Quote Card -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/tagline_background"
                android:padding="14dp">

                <!-- Left Pencil Graphic -->
                <ImageView
                    android:id="@+id/ivQuotePencil"
                    android:layout_width="53dp"
                    android:layout_height="102dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:src="@drawable/tagline_pencil" />

                <!-- Heart Icon Top Right -->

                <!-- Quote Text Graphic -->

                <ImageView
                    android:id="@+id/ivQuoteHeart"
                    android:layout_width="46dp"
                    android:layout_height="44dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="18dp"
                    android:layout_marginEnd="10dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:src="@drawable/tagline_heart" />

                <ImageView
                    android:layout_width="248dp"
                    android:layout_height="82dp"
                    android:layout_centerHorizontal="true"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="21dp"
                    android:layout_toStartOf="@id/ivQuoteHeart"
                    android:layout_toEndOf="@id/ivQuotePencil"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/quote_small_steps"
                    android:scaleType="fitCenter"
                    android:src="@drawable/tagline" />

            </RelativeLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/nav_home"
            android:textColor="#FFCC00"
            android:textSize="11sp"
            app:drawableTopCompat="@drawable/ic_home_main" />

        <TextView
            android:id="@+id/navStudents"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/nav_students"
            android:textColor="#000000"
            android:textSize="11sp"
            app:drawableTopCompat="@drawable/ic_students_main" />

        <TextView
            android:id="@+id/navGrades"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/nav_grades"
            android:textColor="#000000"
            android:textSize="11sp"
            app:drawableTopCompat="@drawable/ic_grades_main" />

        <TextView
            android:id="@+id/navAnalytics"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/analytics"
            android:textColor="#000000"
            android:textSize="11sp"
            app:drawableTopCompat="@drawable/ic_analytics_main" />
    </LinearLayout>

</LinearLayout>